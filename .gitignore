# ==============================================================================
# Voice Sampler - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Data, Audio & Machine Learning Weights
# ------------------------------------------------------------------------------
# Runtime database, user samples, generated audio, model checkpoints, and cache
/data/*
!/data/**/.gitkeep
!/data/README.md

# Large model weight checkpoints (safety rule for any directory)
*.pth
*.pt
*.bin
*.safetensors
*.onnx
*.ckpt

# Databases & SQLite temporary journals
*.db
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Audio datasets & raw recordings (outside data/ if any)
*.wav
*.mp3
*.flac
*.ogg
*.m4a
!tests/fixtures/**/*.wav
!tests/fixtures/**/*.mp3

# ------------------------------------------------------------------------------
# 2. Node & Frontend (React / Vite / Electron / TypeScript)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-electron/
release/
out/
.vite/

# TypeScript build info cache (e.g. tsconfig.node.tsbuildinfo)
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Python & Backend (FastAPI / PyTorch / Testing)
# ------------------------------------------------------------------------------
# Bytecode & CPython cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# Distribution & Packaging
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 4. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# 5. AI Coding Assistants & Agent Workspaces
# ------------------------------------------------------------------------------
.agents/
.gemini/
.claude/
.cursor/
.windsurf/

# ------------------------------------------------------------------------------
# 6. Operating System & IDE Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# JetBrains (PyCharm / WebStorm / IDEA)
.idea/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Miscellaneous
*.log
*.tmp
*.bak
*~

